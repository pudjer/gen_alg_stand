@page "/history"
@using Studio
@inject IExperimentStore Store

<PageTitle>History</PageTitle>

<div class="container-fluid">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h1 class="h3 mb-0">Experiment history</h1>
        <button class="btn btn-outline-secondary" disabled="@_loading" @onclick="RefreshAsync">Refresh</button>
    </div>

    @if (_loading)
    {
        <div class="text-muted">Loading…</div>
    }
    else if (_experiments.Count == 0)
    {
        <div class="alert alert-light border">
            No experiments saved yet. Run one in the <NavLink href="builder" Match="NavLinkMatch.Prefix">Builder</NavLink>.
        </div>
    }
    else
    {
        <div class="card mb-3">
            <div class="card-body">
                <LineChart Title="Best loss — saved experiments" Series="_chartSeries" />
                @if (_experiments.Count > 8)
                {
                    <div class="small text-muted">Showing the 8 most recent in the chart.</div>
                }
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-striped align-middle">
                <thead>
                    <tr>
                        <th>Problem</th>
                        <th>Operators</th>
                        <th>Seed</th>
                        <th>Generations</th>
                        <th>Best loss</th>
                        <th>Elapsed (ms)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _experiments)
                    {
                        <tr>
                            <td>
                                <div>@item.Result.Config.ProblemKey</div>
                                <div class="small text-muted">
                                    @foreach (var (key, value) in item.Result.Config.ProblemParameters)
                                    {
                                        <span class="badge text-bg-light font-monospace">@key=@value</span>
                                    }
                                </div>
                            </td>
                            <td class="small text-muted">
                                <div>@item.Result.Config.CrossoverKey / @item.Result.Config.MutationKey</div>
                                <div>@item.Result.Config.SelectionKey / @item.Result.Config.AlgorithmKey</div>
                            </td>
                            <td>@item.Result.Config.Seed</td>
                            <td>@item.Result.History.Count</td>
                            <td>@item.Result.BestLoss.ToString("F4")</td>
                            <td>@item.Result.TotalMilliseconds.ToString("F0")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-danger" disabled="@_busy" @onclick="() => DeleteAsync(item.Id)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private IReadOnlyList<StoredExperiment> _experiments = Array.Empty<StoredExperiment>();
    private IReadOnlyList<ChartSeries> _chartSeries = Array.Empty<ChartSeries>();
    private bool _loading = true;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task RefreshAsync()
    {
        _loading = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _experiments = await Store.ListAsync();
        RebuildChart();
        _loading = false;
        StateHasChanged();
    }

    private void RebuildChart()
    {
        string[] palette =
        {
            "#0d6efd", "#dc3545", "#198754", "#ffc107",
            "#6f42c1", "#fd7e14", "#20c997", "#6c757d",
        };

        var shown = _experiments.Take(8).ToList();
        var series = new List<ChartSeries>(shown.Count);
        for (var i = 0; i < shown.Count; i++)
        {
            var item = shown[i];
            series.Add(new ChartSeries(
                $"#{i + 1} {item.Result.Config.ProblemKey}",
                palette[i % palette.Length],
                item.Result.History.Select(h => h.Best).ToList()));
        }

        _chartSeries = series;
    }

    private async Task DeleteAsync(string id)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            await Store.DeleteAsync(id);
            _experiments = await Store.ListAsync();
            RebuildChart();
        }
        finally
        {
            _busy = false;
        }

        StateHasChanged();
    }
}
