@page "/builder"
@implements IDisposable
@using Catalog
@using Parameters
@using Studio
@inject ICatalog Catalog
@inject IExperimentStore Store

<PageTitle>Builder</PageTitle>

<div class="container-fluid">
    <h1 class="h3 mb-3">Experiment builder</h1>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    <div class="row g-3">
        <div class="col-md-5">
            <div class="card mb-3">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Problem</label>
                        <select class="form-select" @onchange="OnProblemChanged">
                            @foreach (var problem in Catalog.Problems)
                            {
                                <option value="@problem.Key" selected="@(problem.Key == _selectedProblemKey)">@problem.DisplayName</option>
                            }
                        </select>
                    </div>

                    <h2 class="h6">Problem parameters</h2>
                    <ParameterEditor Specs="_problem.Parameters" Values="_problemParameters" OnChanged="OnProblemParameterChanged" />

                    <OperatorPicker Title="Algorithm" Descriptors="_algorithms" SelectedKey="_algorithmKey" Parameters="_algorithmParameters" OnChanged="OnAlgorithmChanged" />
                    <OperatorPicker Title="Crossover" Descriptors="_crossovers" SelectedKey="_crossoverKey" Parameters="_crossoverParameters" OnChanged="OnCrossoverChanged" />
                    <OperatorPicker Title="Mutation" Descriptors="_mutations" SelectedKey="_mutationKey" Parameters="_mutationParameters" OnChanged="OnMutationChanged" />
                    <OperatorPicker Title="Selection" Descriptors="_selections" SelectedKey="_selectionKey" Parameters="_selectionParameters" OnChanged="OnSelectionChanged" />
                    <OperatorPicker Title="Initial population" Descriptors="_initialPopulations" SelectedKey="_initialPopulationKey" Parameters="_initialPopulationParameters" OnChanged="OnInitialPopulationChanged" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Seed</label>
                        <input class="form-control form-control-sm" type="number" value="@_seed" @onchange="OnSeedChanged" />
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" disabled="@_running" @onclick="RunAsync">Run</button>
                        <button class="btn btn-outline-danger" disabled="@(!_running)" @onclick="CancelAsync">Cancel</button>
                        <button class="btn btn-outline-success" disabled="@(_running || _result is null)" @onclick="SaveAsync">Save</button>
                    </div>

                    @if (_problemParameterNote)
                    {
                        <div class="alert alert-warning mt-3 mb-0 small">
                            Problem parameters changed: operator lists may depend on them; selections were validated against the refreshed lists.
                        </div>
                    }
                    @if (_savedMessage is not null)
                    {
                        <div class="alert alert-success mt-3 mb-0">@_savedMessage</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card mb-3">
                <div class="card-body">
                    <LineChart Title="Loss per generation" Series="_series" />
                </div>
            </div>

            @if (_result is not null)
            {
                <div class="card">
                    <div class="card-body">
                        <h2 class="h6">Summary</h2>
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Best loss</dt>
                            <dd class="col-sm-8">@_result.BestLoss</dd>
                            <dt class="col-sm-4">Generations</dt>
                            <dd class="col-sm-8">@_result.History.Count</dd>
                            <dt class="col-sm-4">Elapsed (ms)</dt>
                            <dd class="col-sm-8">@_result.TotalMilliseconds</dd>
                            <dt class="col-sm-4">Completed</dt>
                            <dd class="col-sm-8">@_result.Completed</dd>
                        </dl>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    // ---- Problem and catalog state -------------------------------------------------------
    private IProblemEntry _problem = default!;
    private string _selectedProblemKey = string.Empty;
    private bool _problemParameterNote;

    // ---- Configuration pieces (rebuild ExperimentConfig on Run) ---------------------------
    private Dictionary<string, string> _problemParameters = new();
    private IReadOnlyList<IOperatorDescriptor> _algorithms = Array.Empty<IOperatorDescriptor>();
    private IReadOnlyList<IOperatorDescriptor> _crossovers = Array.Empty<IOperatorDescriptor>();
    private IReadOnlyList<IOperatorDescriptor> _mutations = Array.Empty<IOperatorDescriptor>();
    private IReadOnlyList<IOperatorDescriptor> _selections = Array.Empty<IOperatorDescriptor>();
    private IReadOnlyList<IOperatorDescriptor> _initialPopulations = Array.Empty<IOperatorDescriptor>();
    private string _algorithmKey = string.Empty;
    private string _crossoverKey = string.Empty;
    private string _mutationKey = string.Empty;
    private string _selectionKey = string.Empty;
    private string _initialPopulationKey = string.Empty;
    private Dictionary<string, string> _algorithmParameters = new();
    private Dictionary<string, string> _crossoverParameters = new();
    private Dictionary<string, string> _mutationParameters = new();
    private Dictionary<string, string> _selectionParameters = new();
    private Dictionary<string, string> _initialPopulationParameters = new();
    private int _seed;

    // ---- Run state ------------------------------------------------------------------------
    private readonly List<GenerationStats> _history = new();
    private IReadOnlyList<ChartSeries> _series = Array.Empty<ChartSeries>();
    private ExperimentResult? _result;
    private CancellationTokenSource? _cts;
    private bool _running;
    private string? _error;
    private string? _savedMessage;

    protected override void OnInitialized()
    {
        var first = Catalog.Problems[0];
        LoadProblem(first.Key);
    }

    private void LoadProblem(string problemKey)
    {
        var config = Catalog.CreateDefaultConfig(problemKey);
        _problem = Catalog.FindProblem(problemKey)!;
        _selectedProblemKey = problemKey;

        _problemParameters = new Dictionary<string, string>(config.ProblemParameters);
        _algorithms = _problem.Algorithms;
        _crossovers = _problem.Crossovers;
        _mutations = _problem.Mutations;
        _selections = _problem.Selections;
        _initialPopulations = _problem.InitialPopulations;

        _algorithmKey = config.AlgorithmKey;
        _crossoverKey = config.CrossoverKey;
        _mutationKey = config.MutationKey;
        _selectionKey = config.SelectionKey;
        _initialPopulationKey = config.InitialPopulationKey;
        _algorithmParameters = new Dictionary<string, string>(config.AlgorithmParameters);
        _crossoverParameters = new Dictionary<string, string>(config.CrossoverParameters);
        _mutationParameters = new Dictionary<string, string>(config.MutationParameters);
        _selectionParameters = new Dictionary<string, string>(config.SelectionParameters);
        _initialPopulationParameters = new Dictionary<string, string>(config.InitialPopulationParameters);
        _seed = config.Seed;

        _problemParameterNote = false;
        ResetRunOutput();
    }

    private void ResetRunOutput()
    {
        _history.Clear();
        _result = null;
        _error = null;
        _savedMessage = null;
        RebuildSeries();
    }

    // ---- Event handlers -------------------------------------------------------------------

    private void OnProblemChanged(ChangeEventArgs e)
    {
        var key = e.Value?.ToString() ?? string.Empty;
        if (key.Length == 0 || key == _selectedProblemKey)
        {
            return;
        }

        LoadProblem(key);
    }

    private void OnProblemParameterChanged((string Key, string Value) change)
    {
        _problemParameters[change.Key] = change.Value;
        _problemParameterNote = true;

        // Operator lists may depend on problem parameters (e.g. template size); refresh them
        // and keep the current selection when it still exists, otherwise fall back to the first.
        _algorithms = _problem.Algorithms;
        _crossovers = _problem.Crossovers;
        _mutations = _problem.Mutations;
        _selections = _problem.Selections;
        _initialPopulations = _problem.InitialPopulations;

        _crossoverKey = ResolveSelection(_crossoverKey, _crossovers, _crossoverParameters);
        _mutationKey = ResolveSelection(_mutationKey, _mutations, _mutationParameters);
        _selectionKey = ResolveSelection(_selectionKey, _selections, _selectionParameters);
        _initialPopulationKey = ResolveSelection(_initialPopulationKey, _initialPopulations, _initialPopulationParameters);
    }

    private string ResolveSelection(string key, IReadOnlyList<IOperatorDescriptor> descriptors, Dictionary<string, string> parameters)
    {
        var descriptor = descriptors.FirstOrDefault(d => d.Key == key);
        if (descriptor is null)
        {
            descriptor = descriptors.FirstOrDefault();
            key = descriptor?.Key ?? string.Empty;
        }

        parameters.Clear();
        if (descriptor is not null)
        {
            foreach (var spec in descriptor.Parameters)
            {
                parameters[spec.Key] = spec.Default;
            }
        }

        return key;
    }

    private Task OnAlgorithmChanged((string Key, IReadOnlyDictionary<string, string> Parameters) change) =>
        OnOperatorChanged(change, k => _algorithmKey = k, p => _algorithmParameters = new Dictionary<string, string>(p));

    private Task OnCrossoverChanged((string Key, IReadOnlyDictionary<string, string> Parameters) change) =>
        OnOperatorChanged(change, k => _crossoverKey = k, p => _crossoverParameters = new Dictionary<string, string>(p));

    private Task OnMutationChanged((string Key, IReadOnlyDictionary<string, string> Parameters) change) =>
        OnOperatorChanged(change, k => _mutationKey = k, p => _mutationParameters = new Dictionary<string, string>(p));

    private Task OnSelectionChanged((string Key, IReadOnlyDictionary<string, string> Parameters) change) =>
        OnOperatorChanged(change, k => _selectionKey = k, p => _selectionParameters = new Dictionary<string, string>(p));

    private Task OnInitialPopulationChanged((string Key, IReadOnlyDictionary<string, string> Parameters) change) =>
        OnOperatorChanged(change, k => _initialPopulationKey = k, p => _initialPopulationParameters = new Dictionary<string, string>(p));

    private Task OnOperatorChanged(
        (string Key, IReadOnlyDictionary<string, string> Parameters) change,
        Action<string> setKey,
        Action<Dictionary<string, string>> setParameters)
    {
        setKey(change.Key);
        setParameters(new Dictionary<string, string>(change.Parameters));
        ResetRunOutput();
        return Task.CompletedTask;
    }

    private void OnSeedChanged(ChangeEventArgs e) =>
        _seed = int.TryParse(e.Value?.ToString(), out var seed) ? seed : _seed;

    // ---- Run / Cancel / Save --------------------------------------------------------------

    private ExperimentConfig BuildConfig() => new(
        _selectedProblemKey,
        new Dictionary<string, string>(_problemParameters),
        _algorithmKey,
        new Dictionary<string, string>(_algorithmParameters),
        _crossoverKey,
        new Dictionary<string, string>(_crossoverParameters),
        _mutationKey,
        new Dictionary<string, string>(_mutationParameters),
        _selectionKey,
        new Dictionary<string, string>(_selectionParameters),
        _initialPopulationKey,
        new Dictionary<string, string>(_initialPopulationParameters),
        _seed);

    private async Task RunAsync()
    {
        if (_running)
        {
            return; // guard re-entrancy
        }

        ResetRunOutput();
        _running = true;
        _cts = new CancellationTokenSource();

        var progress = new Progress<GenerationStats>(stats =>
            InvokeAsync(() =>
            {
                _history.Add(stats);
                RebuildSeries();
                StateHasChanged();
            }));

        try
        {
            var config = BuildConfig();
            IExperimentRunner runner = _problem.CreateRunner(config);
            _result = await Task.Run(() => runner.RunAsync(config, progress, _cts.Token));
        }
        catch (OperationCanceledException ex)
        {
            _error = "Run cancelled: " + ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _running = false;
            StateHasChanged();
        }
    }

    private async Task CancelAsync()
    {
        if (_cts is not null)
        {
            await Task.Run(() => _cts.Cancel());
        }
    }

    private async Task SaveAsync()
    {
        if (_running || _result is null)
        {
            return;
        }

        try
        {
            var id = await Store.SaveAsync(_result);
            _savedMessage = $"Saved experiment {id}.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void RebuildSeries()
    {
        _series = new[]
        {
            new ChartSeries("Best", "#2563eb", _history.Select(s => s.Best).ToArray()),
            new ChartSeries("Mean", "#16a34a", _history.Select(s => s.Mean).ToArray()),
            new ChartSeries("Worst", "#dc2626", _history.Select(s => s.Worst).ToArray()),
        };
    }

    public void Dispose()
    {
        _cts?.Dispose();
        _cts = null;
    }
}
