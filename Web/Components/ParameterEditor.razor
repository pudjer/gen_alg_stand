<div class="param-editor">
    @foreach (var spec in Specs)
    {
        var key = spec.Key;
        <div class="param-row mb-2">
            <label class="form-label mb-0" for="@($"{_idPrefix}-{key}")">
                @spec.DisplayName
                <span class="text-muted font-monospace small">[@key]</span>
            </label>
            @if (spec.IsNumeric)
            {
                <input id="@($"{_idPrefix}-{key}")" class="form-control form-control-sm"
                       type="number"
                       value="@GetValue(key)"
                       min="@spec.Min" max="@spec.Max" step="@(spec.Step ?? 0.01)"
                       @onchange="e => OnChanged.InvokeAsync((key, e.Value?.ToString() ?? spec.Default))" />
                @if (spec.Min is double lo && spec.Max is double hi && hi - lo is var span && span is > 0 and <= 1000)
                {
                    <input class="form-range mt-1" type="range"
                           value="@GetValue(key)"
                           min="@lo" max="@hi" step="@(spec.Step ?? span / 100.0)"
                           @onchange="e => OnChanged.InvokeAsync((key, e.Value?.ToString() ?? spec.Default))" />
                }
            }
            else if (spec.Kind == ParameterKind.Bool)
            {
                <input id="@($"{_idPrefix}-{key}")" class="form-check-input" type="checkbox"
                       checked="@IsTrue(key)"
                       @onchange='e => OnChanged.InvokeAsync((key, e.Value?.ToString()?.ToLowerInvariant() ?? "false"))' />
            }
            else if (spec.Kind == ParameterKind.Choice)
            {
                <select id="@($"{_idPrefix}-{key}")" class="form-select form-select-sm"
                        value="@GetValue(key)"
                        @onchange="e => OnChanged.InvokeAsync((key, e.Value?.ToString() ?? spec.Default))">
                    @if (spec.Options is not null)
                    {
                        @foreach (var opt in spec.Options)
                        {
                            <option value="@opt">@opt</option>
                        }
                    }
                </select>
            }
            else
            {
                <input id="@($"{_idPrefix}-{key}")" class="form-control form-control-sm" type="text"
                       value="@GetValue(key)"
                       @onchange="e => OnChanged.InvokeAsync((key, e.Value?.ToString() ?? spec.Default))" />
            }
            @if (!string.IsNullOrWhiteSpace(spec.Description))
            {
                <div class="form-text small mb-0">@spec.Description</div>
            }
        </div>
    }
</div>

@code {
    private readonly string _idPrefix = "pe-" + Guid.NewGuid().ToString("N");

    /// <summary>Gets or sets the specs describing every parameter to render.</summary>
    [Parameter]
    public IReadOnlyList<ParameterSpec> Specs { get; set; } = Array.Empty<ParameterSpec>();

    /// <summary>Gets or sets the current raw string values, keyed by parameter key.</summary>
    [Parameter]
    public IReadOnlyDictionary<string, string> Values { get; set; } = new Dictionary<string, string>();

    /// <summary>Gets or sets the callback invoked when one parameter changes.</summary>
    [Parameter]
    public EventCallback<(string Key, string Value)> OnChanged { get; set; }

    private string GetValue(string key) =>
        Values.TryGetValue(key, out var value) ? value : string.Empty;

    private static bool IsTrue(string raw) =>
        string.Equals(raw, "true", StringComparison.OrdinalIgnoreCase) || raw == "1";
}
