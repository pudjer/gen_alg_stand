<div class="operator-picker mb-3">
    <label class="form-label mb-0 fw-bold">@Title</label>
    <select class="form-select form-select-sm" @onchange="OnSelectionChanged">
        @foreach (var d in Descriptors)
        {
            <option value="@d.Key" selected="@(d.Key == SelectedKey)">@d.DisplayName</option>
        }
    </select>
    <ParameterEditor Specs="@(SelectedDescriptor?.Parameters ?? Array.Empty<ParameterSpec>())"
                     Values="Parameters"
                     OnChanged="OnParameterChanged" />
</div>

@code {
    /// <summary>Gets or sets the heading shown above the picker.</summary>
    [Parameter]
    public string Title { get; set; } = string.Empty;

    /// <summary>Gets or sets the selectable operators.</summary>
    [Parameter]
    public IReadOnlyList<IOperatorDescriptor> Descriptors { get; set; } = Array.Empty<IOperatorDescriptor>();

    /// <summary>Gets or sets the key of the currently selected operator.</summary>
    [Parameter]
    public string SelectedKey { get; set; } = string.Empty;

    /// <summary>Gets or sets the parameters of the selected operator.</summary>
    [Parameter]
    public IReadOnlyDictionary<string, string> Parameters { get; set; } = new Dictionary<string, string>();

    /// <summary>
    /// Gets or sets the callback invoked when the selection or a parameter changes; the payload is
    /// the selected key and the full (possibly updated) parameter dictionary.
    /// </summary>
    [Parameter]
    public EventCallback<(string Key, IReadOnlyDictionary<string, string> Parameters)> OnChanged { get; set; }

    private IOperatorDescriptor? SelectedDescriptor =>
        Descriptors.FirstOrDefault(d => d.Key == SelectedKey);

    private async Task OnSelectionChanged(ChangeEventArgs e)
    {
        var key = e.Value?.ToString() ?? string.Empty;
        var descriptor = Descriptors.FirstOrDefault(d => d.Key == key);
        var defaults = new Dictionary<string, string>();
        if (descriptor is not null)
        {
            foreach (var spec in descriptor.Parameters)
            {
                defaults[spec.Key] = spec.Default;
            }
        }

        await OnChanged.InvokeAsync((key, defaults));
    }

    private async Task OnParameterChanged((string Key, string Value) change)
    {
        var updated = new Dictionary<string, string>(Parameters)
        {
            [change.Key] = change.Value,
        };

        await OnChanged.InvokeAsync((SelectedKey, updated));
    }
}
